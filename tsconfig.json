{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "out",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "core/src",
    "vscode/src",
    "vscode/scripts",
    "playground/src",
    "site/src",
    "conformance",
    "changelog",
    "fuzz",
    "test",
    "giveaway",
    "burn",
    "mutation",
    "locker"
  ]
}
